pipeline{
    agent any
    environment {
        INNO_SETUP_URL = "https://files.jrsoftware.org/is/6/innosetup-6.2.0.exe"
    }
    stages{
        
        stage('Installing depencencies'){
            agent { label 'windows-node' }
            steps{
                bat 'npm install --frozen-lockfile'
                // pack for windows

                bat 'npm run pack:windows'   //"pack:windows": "electron-packager . --platform=win32 --arch=x64 --asar --overwrite --out=./dist/ --icon=./resources/icons/normal/windows.ico",
                // download inno setup in the windows directory
                bat 'curl --max-time 30 --retry 3 -L -o .\\windows\\innosetup.exe %INNO_SETUP_URL%'
                // show all the files in the windows directory
                bat 'dir .\\windows'
                // install inno setup
                bat 'start .\\windows\\innosetup.exe /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /NOCANCEL /SP-'

                // create installer
                bat 'npm run build:windows'
                bat 'dir .\\windows'

                archiveArtifacts artifacts: 'dist/installers/*.exe', fingerprint: true
            }
        }
        stage('Uploading installer'){
            agent {
                docker {
                    image 'alpine:latest'
                    args '-u root'
                }
                
            }
            environment {
                USER = credentials('remote-server-user')
                HOST = credentials('remote-server-host')
                REMOTE_KEY = credentials('remote-key')
            }
            
            steps {
                sh 'mkdir -p builds'
                sh 'cp -r dist/installers/*.exe ./builds/'
                def remoteHost = env.HOST
                def remoteUser = env.USER
                def remoteKey = env.REMOTE_KEY
                sh 'scp -i ${remoteKey} builds/*.exe ${remoteUser}@${remoteHost}:/home/shoumik/gchat-builds/'
                
               
            }

            
        }
    }
}